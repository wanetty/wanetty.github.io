---
import MDLayout from "@/layouts/MDLayout.astro";
import { getCollection } from "astro:content";
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => {
    return data.lang === 'en';
  });

  return posts.map((post) => ({
    params: { id: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { 
  title, 
  description, 
  SEOTitle, 
  date, 
  category, 
  snippetone
} = data;

// Crear un array de tags sin duplicados (usando Set)
let tagsSet = new Set([snippetone, category].filter(Boolean));
const tags = [...tagsSet];

// URL para la imagen si existe
const imageUrl = post.data.imageUrl || null;

const { Content } = await post.render();
---

<MDLayout 
  title={title} 
  description={description} 
  SEOTitle={SEOTitle}
  publishDate={date}
  category={category}
  tags={tags}
  imageUrl={imageUrl}
>
  <Content />
</MDLayout>