---
import ChevronIcon from "@/components/icons/Chevron.astro"
import { LANGUAGES } from '../i18n/ui';
import { getRouteFromUrl, useTranslatedPath, getLangFromUrl } from '@/i18n/utils';

// Obtenemos información básica sobre la URL actual
const route = getRouteFromUrl(Astro.url);
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

// Analizar la URL actual para detectar patrones específicos
const pathname = Astro.url.pathname;
const isPostPage = pathname.includes('/post/');

// Extraer el slug del post actual si estamos en una página de post
let currentSlug = '';
if (isPostPage) {
  const parts = pathname.split('/');
  // Filtrar partes vacías que pueden ocurrir por slash final
  const filteredParts = parts.filter(part => part.length > 0);
  currentSlug = filteredParts[filteredParts.length - 1]; // Último segmento no vacío de la URL
}

// Función para obtener el nombre base de un post sin el sufijo de idioma
const getBaseSlug = (slug: string): string => {
  if (slug.endsWith('_es')) return slug.slice(0, -3);
  if (slug.endsWith('_en')) return slug.slice(0, -3);
  return slug;
};

// Función mejorada para generar URLs según el idioma seleccionado
const getUrlForLanguage = (targetLang: string) => {
  // CASO 1: Estamos en una página de post
  if (isPostPage && currentSlug) {
    // Obtener el slug base (sin sufijo de idioma)
    const baseSlug = getBaseSlug(currentSlug);
    
    // Si el slug base está vacío, significa que algo está mal
    if (!baseSlug) {
      console.error('Error: No se pudo determinar el slug base del post');
      return translatePath('/', targetLang); // Volver a inicio como fallback
    }
    
    // Crear el nuevo slug para el idioma de destino
    const newSlug = `${baseSlug}_${targetLang}`;
    
    // Generar la URL correcta según el idioma
    // Para español: /post/slug_es/
    // Para inglés: /en/post/slug_en/
    return `/${targetLang === 'es' ? '' : targetLang + '/'}post/${newSlug}/`;
  }
  
  // Si no estamos en un post, usar la lógica normal de traducción
  return translatePath(`/${route ? route : ''}`, targetLang);
};

const currentLocaleData = LANGUAGES[lang];
const otherLocales = Object.values(LANGUAGES).filter(
  (locale) => locale.code !== lang
);

const {newclases = "text-xs sm:text-sm", isMobile = false} = Astro.props;
---

<div class="flex items-center justify-center relative">
  <div
    class={`${newclases} group text-white rounded-md font-semibold bg-black/30 hover:bg-black/70 transition-all`}
  >
  <div class="relative group">
    <button
      type="button"
      class={`${newclases} flex items-center gap-1 text-white rounded-md font-medium bg-black/30 hover:bg-black/70 transition-all px-2 py-2 sm:px-3`}
      aria-expanded="true"
      aria-haspopup="true"
    >
      <currentLocaleData.flag />
      <span class="hidden sm:inline">{currentLocaleData.name}</span>
      <ChevronIcon />
    </button>
  
    <ul class="group-hover:block group-hover:animate-fade-down group-hover:animate-duration-200 hidden pt-0.5 absolute w-full">
      {otherLocales.map((locale: { code: string, flag: any, name: string }) => (
        <li class="py-[2px]">
          <a
            class="rounded-md bg-black/30 hover:bg-black/70 whitespace-no-wrap flex items-center gap-1 w-full px-2 py-2 sm:px-3"
            href={getUrlForLanguage(locale.code)}
            data-astro-reload
          >
            <locale.flag />
            <span class="hidden sm:inline">{locale.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>